# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPERATOR_MODEL=claude-sonnet-5-5
# USD per million tokens for the cost model: check the current price list for your model
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0

# sandbox (default) or real
APPLY_MODE=sandbox
SANDBOX_URL=http://127.0.0.1:8100

# Stop rule
MAX_STEPS=20
MAX_COST_USD=0.50
MAX_TOKENS_TOTAL=250000
MAX_WALL_SECONDS=600
MAX_SUBMISSIONS=1
MAX_IDENTICAL_CALLS=3

# Real-mode email only (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
