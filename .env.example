# Copy to .env and fill in (python install.py does the copy). Never commit .env.

# ---------------- Model ----------------
# Option A (default): Claude via the Anthropic API
OPERATOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Haiku 5.5 is the cheap choice for testing (well under 1 cent per run).
# Sonnet 5.5 is stronger and about 20x the price: OPERATOR_MODEL=claude-sonnet-5-5, prices 2.0 / 10.0
OPERATOR_MODEL=claude-haiku-5-5
# USD per million tokens for the cost model (Anthropic list price; prompt-cache reads/writes are priced from these)
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50

# Option B (free): any OpenAI-compatible server. Set OPERATOR_PROVIDER=openai, pick ONE block,
# set OPERATOR_MODEL to a model that supports tool calling, and set both prices to 0.
#   Groq (free tier):        OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_API_KEY=gsk_...
#   OpenRouter (free models): OPENAI_BASE_URL=https://openrouter.ai/api/v1     OPENAI_API_KEY=sk-or-...
#   Ollama (local, no key):  OPENAI_BASE_URL=http://localhost:11434/v1
#   OpenAI (paid, cheap):    OPENAI_BASE_URL=https://api.openai.com/v1      OPENAI_API_KEY=sk-proj-...
#                            OPERATOR_MODEL=gpt-4.1-mini  PRICE_IN_PER_MTOK=0.40  PRICE_OUT_PER_MTOK=1.60 (check openai.com/api/pricing)
# Free models are weaker at multi-step tool use: expect more failed runs than with Claude.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---------------- Where writes go ----------------
# sandbox (default) or real
APPLY_MODE=sandbox
SANDBOX_URL=http://127.0.0.1:8100

# ---------------- Real job sites with browser-use ----------------
# on = the agent can search LinkedIn / Indeed / StepStone / the web and apply on real application pages.
# It fills the form, you approve the filled form (screenshot + values), then The Operator clicks Submit.
BROWSER_USE=off
# Model for the browser agent (default: OPERATOR_MODEL). browser-use's model writes Python; use a strong model.
BROWSER_MODEL=
# false = you see the browser window (needed once to log in to LinkedIn/Indeed; the login is kept in data/browser-profile)
BROWSER_HEADLESS=false
# Path to Chrome/Chromium/Edge if it is not found automatically
BROWSER_EXECUTABLE=
BROWSER_MAX_STEPS=30
BROWSER_TIMEOUT_S=300
# true = the browser may open any site while filling (default: the job's site + known application systems only)
BROWSER_ANY_DOMAIN=false
# browser-use sends anonymous usage telemetry unless this is false
ANONYMIZED_TELEMETRY=false

# ---------------- LangSmith tracing ----------------
# Every run becomes a LangSmith thread: model calls (with tokens/cost), tool calls, approvals, browser-use tasks.
# Free key: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-operator
# EU accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ---------------- Stop rule ----------------
MAX_STEPS=20
MAX_COST_USD=0.50
MAX_TOKENS_TOTAL=250000
# wall time excludes time spent waiting for you; browser tasks are slow
MAX_WALL_SECONDS=900
MAX_SUBMISSIONS=1
MAX_IDENTICAL_CALLS=3

# ---------------- Real-mode email only (e.g. Gmail with an app password) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
