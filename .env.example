# Copy to .env and fill in (python install.py does the copy). Never commit .env.

# ---------------- Model ----------------
# Option A (default): Claude via the Anthropic API
OPERATOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Haiku 5.5 is the cheap choice for testing (well under 1 cent per run).
# Sonnet 5.5 is stronger and about 20x the price: OPERATOR_MODEL=claude-sonnet-5-5, prices 2.0 / 10.0
OPERATOR_MODEL=claude-haiku-5-5
# USD per million tokens for the cost model (Anthropic list price; prompt-cache reads/writes are priced from these)
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50

# Option B (free): any OpenAI-compatible server. Set OPERATOR_PROVIDER=openai, pick ONE block,
# set OPERATOR_MODEL to a model that supports tool calling, and set both prices to 0.
#   Groq (free tier):        OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_API_KEY=gsk_...
#   OpenRouter (free models): OPENAI_BASE_URL=https://openrouter.ai/api/v1     OPENAI_API_KEY=sk-or-...
#   Ollama (local, no key):  OPENAI_BASE_URL=http://localhost:11434/v1
#   OpenAI (paid, cheap):    OPENAI_BASE_URL=https://api.openai.com/v1      OPENAI_API_KEY=sk-proj-...
#                            OPERATOR_MODEL=gpt-4.1-mini  PRICE_IN_PER_MTOK=0.40  PRICE_OUT_PER_MTOK=1.60 (check openai.com/api/pricing)
# Free models are weaker at multi-step tool use: expect more failed runs than with Claude.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---------------- Where writes go ----------------
# sandbox (default) or real
APPLY_MODE=sandbox
SANDBOX_URL=http://127.0.0.1:8100

# ---------------- Stop rule ----------------
MAX_STEPS=20
MAX_COST_USD=0.50
MAX_TOKENS_TOTAL=250000
MAX_WALL_SECONDS=600
MAX_SUBMISSIONS=1
MAX_IDENTICAL_CALLS=3

# ---------------- Real-mode email only (e.g. Gmail with an app password) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
